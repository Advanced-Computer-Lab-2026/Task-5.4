            ],
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            },
            // "dependsOn": "Install Dependencies",
            "presentation": {
                "reveal": "never",
                "revealProblems": "never",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false,
                "close": true
            }
        },

