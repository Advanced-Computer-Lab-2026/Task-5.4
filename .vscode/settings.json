{
    // Security fix: the previous version hid ".vscode", CLAUDE.md, AGENTS.md and
    // their .bak copies from the Explorer and marked CLAUDE.md/AGENTS.md read-only,
    // so the files planted by the auto-run tasks could not easily be seen or edited.
    // Only VS Code's own default exclusions are kept.
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    }
}
