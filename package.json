{
  "name": "task-3-dormbooking",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm --workspaces install",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev --workspace server\" \"npm:dev --workspace client\"",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0",
    "esbuild": "npm:esbuild-wasm@0.21.5",
    "rollup": "npm:@rollup/wasm-node@4.64.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "mongodb-memory-server@11.3.0": true
  },
  "overrides": {
    "esbuild": "$esbuild",
    "rollup": "$rollup",
    "tar-stream": "3.1.7"
  }
}
