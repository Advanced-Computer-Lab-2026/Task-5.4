{
  "name": "task-3-dormbooking",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm --workspaces install",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev --workspace server\" \"npm:dev --workspace client\"",
    "test": "jest"
  },
  "jest": {
    "projects": [
      {
        "displayName": "server",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/server/**/*.test.js"
        ],
        "transform": {
          "^.+\\.js$": [
            "babel-jest",
            {
              "presets": [
                [
                  "@babel/preset-env",
                  {
                    "targets": {
                      "node": "current"
                    }
                  }
                ]
              ]
            }
          ]
        }
      },
      {
        "displayName": "client",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/tests/client/**/*.test.js"
        ],
        "transform": {
          "^.+\\.js$": [
            "babel-jest",
            {
              "presets": [
                [
                  "@babel/preset-env",
                  {
                    "targets": {
                      "node": "current"
                    }
                  }
                ]
              ]
            }
          ]
        }
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^30.0.0",
    "concurrently": "^8.2.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.0.0",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^8.24.8",
    "supertest": "^7.3.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "mongodb-memory-server@11.3.0": true
  }
}
